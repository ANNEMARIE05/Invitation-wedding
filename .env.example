# Modèle uniquement — React ne lit PAS ce fichier.
# 1. Copiez ce fichier en .env.local (même dossier)
# 2. Renseignez REACT_APP_COUPLE_PASSWORD
# 3. Arrêtez puis relancez : npm start
REACT_APP_COUPLE_PASSWORD=

# Données invités (RSVP, livre d’or, réglages, photos) : navigateur uniquement
# (localStorage + IndexedDB). Session espace mariés : sessionStorage (~12 h).

# Une fois : vide localStorage (+ photos IndexedDB) au prochain npm start, puis retirez cette ligne.
# REACT_APP_WIPE_LOCAL_STORAGE=1
